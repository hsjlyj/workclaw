# workclaw 环境变量示例
#
# 复制后按你的部署方式填写：
# - 本地开发可放进 .dev.vars 或用 wrangler secret put
# - Cloudflare 线上推荐用 wrangler secret put 管理敏感值
#
# ─── 必填 ────────────────────────────────────────────

# Telegram Bot API token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram webhook 校验 secret
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ─── OpenAI 兼容接口（可选） ────────────────────────────

# /v1/* 接口的客户端访问密钥
CLAW_API_KEY=your-client-api-key

# 上游 OpenAI-compatible 服务地址；不填时走本地兜底回复
OPENAI_BASE_URL=https://api.openai.com/v1

# 上游接口鉴权 token；只在配置了 OPENAI_BASE_URL 时有用
OPENAI_API_KEY=your-openai-api-key

# ─── 模型配置 ──────────────────────────────────────────

# 项目优先使用的模型名（CLAW_MODEL 优先于 OPENAI_MODEL）
CLAW_MODEL=gemini-3.1-flash-lite

# 备用模型名
OPENAI_MODEL=gpt-4.1-mini

# ─── 运行环境 ──────────────────────────────────────────
# production / development / staging
CLAW_ENV=production

# ─── KV 缓存（部署后自动创建命名空间） ──────────────────
# 前缀: search:<query>  /  scrape:<url>  /  session:<chatId>:meta
WORKCLAW_CACHE_LOCAL=true

# ─── R2 对象存储（部署后自动创建 bucket） ────────────────
# 存储网页快照和超长会话上下文
WORKCLAW_ASSETS_LOCAL=true

# ─── Workers AI（推荐，零额外成本） ────────────────────
# 部署后自动可用，用于边缘推理和 embedding
# 也可在本地设置 OPENAI_BASE_URL 使用外部模型

# ─── Vectorize 语义记忆（部署后需手动创建索引） ─────────
# npx wrangler vectorize create workclaw-memories --dimensions=768 --metric=cosine
