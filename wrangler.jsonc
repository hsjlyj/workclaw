{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workclaw",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "OPENAI_BASE_URL": "https://new-api.abrdns.com/v1",
    "CLAW_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "CLAW_ENV": "production"
  },

  // ─── Durable Objects (会话状态 + SQLite) ───────────────────────────
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_SESSION",
        "class_name": "TelegramSession"
      }
    ]
  },
  "exports": {
    "TelegramSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "migrations": [
    { "tag": "v1", "new_classes": ["TelegramSession"] }
  ],

  // ─── KV 缓存 (搜索结果 / 网页抓取 / 短期数据) ──────────────────────
  "kv_namespaces": [
    {
      "binding": "WORKCLAW_CACHE",
      "id": "<auto-generated-once-deployed>",
      "preview_id": "<auto-generated-once-deployed>"
    }
  ],

  // ─── R2 对象存储 (大文件缓存 / 网页快照) ────────────────────────────
  "r2_buckets": [
    {
      "binding": "WORKCLAW_ASSETS",
      "bucket_name": "workclaw-assets",
      "preview_bucket_name": "workclaw-assets-preview"
    }
  ],

  // ─── Workers AI (免密钥边缘推理) ─────────────────────────────────────
  "ai": {
    "binding": "WORKCLAW_AI"
  },

  // ─── Vectorize (长期记忆语义搜索) ────────────────────────────────────
  "vectorize": [
    {
      "binding": "WORKCLAW_VECTORIZE",
      "index_name": "workclaw-memories"
    }
  ],

  // ─── Cron 定时触发器 (提醒投递 / 监控检查 / 记忆整理) ────────────────
  "triggers": {
    "crons": [
      {
        "type": "cron",
        "crons": ["*/5 * * * *"],
        "endpoint": "cron/dispatch"
      }
    ]
  },

  // ─── Pages (状态仪表盘) ──────────────────────────────────────────────
  "pages_build_output_dir": "./public"
}
